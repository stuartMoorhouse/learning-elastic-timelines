# Generated by Terraform and kept only in state (gitignored). Read with: terraform output -raw vm_admin_password
resource "random_password" "vm_admin" {
  length           = 24
  special          = true
  override_special = "!@#%^*-_=+"
  min_upper        = 2
  min_lower        = 2
  min_numeric      = 2
  min_special      = 2
}

resource "azurerm_windows_virtual_machine" "attack" {
  # checkov:skip=CKV_AZURE_50: CustomScriptExtension is the bootstrap mechanism (Elastic Agent, Atomic Red Team) for this demo VM
  name                = "${var.prefix}-attack"
  computer_name       = "tl-attack"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  size                = var.vm_size
  admin_username      = var.vm_admin_username
  admin_password      = random_password.vm_admin.result

  network_interface_ids = [azurerm_network_interface.vm.id]

  # Regular priority only: never Spot. No eviction_policy or max_bid_price.
  priority = "Regular"

  # Bootstrap script, written by Azure to C:\AzureData\CustomData.bin (limit 65535 bytes).
  # Contains no secrets; the Fleet enrollment token is passed via the extension's protected settings.
  custom_data = base64encode(local.bootstrap_script)

  # Encrypts temp disk and caches at host (OS disk is also encrypted at rest by the platform).
  # Needs the EncryptionAtHost subscription feature; see var.encryption_at_host_enabled.
  encryption_at_host_enabled = var.encryption_at_host_enabled

  provision_vm_agent         = true
  automatic_updates_enabled  = true
  patch_mode                 = "AutomaticByPlatform"
  hotpatching_enabled        = false
  allow_extension_operations = true

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 128
  }

  source_image_reference {
    publisher = "MicrosoftWindowsServer"
    offer     = "WindowsServer"
    sku       = "2022-datacenter-azure-edition"
    version   = "latest"
  }

  boot_diagnostics {}

  lifecycle {
    precondition {
      condition     = fileexists(local.apt29_script_path)
      error_message = "scripts/vm/Invoke-APT29.ps1 is missing; generate it before plan/apply."
    }
    precondition {
      condition     = length(local.bootstrap_script) <= 60000
      error_message = "Rendered bootstrap script exceeds the ~64KB custom_data limit; shrink Invoke-APT29.ps1."
    }
  }

  tags = local.tags
}

resource "azurerm_virtual_machine_extension" "bootstrap" {
  name                       = "demo-bootstrap"
  virtual_machine_id         = azurerm_windows_virtual_machine.attack.id
  publisher                  = "Microsoft.Compute"
  type                       = "CustomScriptExtension"
  type_handler_version       = "1.10"
  auto_upgrade_minor_version = true

  protected_settings = jsonencode({
    commandToExecute = join(" ", [
      "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command",
      "\"Copy-Item C:\\AzureData\\CustomData.bin C:\\demo-bootstrap.ps1 -Force;",
      "& C:\\demo-bootstrap.ps1",
      "-FleetUrl '${local.fleet_url}'",
      "-EnrollmentToken '${local.enrollment_token}'",
      "-ElasticVersion '${data.ec_stack.main.version}';",
      "exit $LASTEXITCODE\""
    ])
  })

  timeouts {
    create = "45m"
  }

  tags = local.tags
}
