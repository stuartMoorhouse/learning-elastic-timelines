azure_subscription_id = "00000000-0000-0000-0000-000000000000"
region                = "westeurope"
ec_region             = "azure-westeurope"
prefix                = "elastic-timelines"
elastic_version       = "9.5.3"
presenter_ip_cidr     = "203.0.113.5/32"
vm_size               = "Standard_B2ms"
vm_admin_username     = "demoadmin"
# VM admin password is generated by Terraform (random_password); read it with: terraform output -raw vm_admin_password

# Required by the Azure subscription policy (Resource Groups need team and division).
tags = {
  division   = "field"
  org        = "sa"
  team       = "your_team"
  project    = "your.email@example.com"
  keep-until = "2026-12-31"
}
